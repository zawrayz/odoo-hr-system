<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <record id="ir_cron_management_auto_attendance"
                model="ir.cron">

            <field name="name">
                Management Automatic Attendance
            </field>

            <field name="model_id"
                   ref="model_hr_attendance_register_line"/>

            <field name="state">code</field>

            <field name="code">
                model.cron_fill_management_attendance()
            </field>

            <field name="user_id"
                   ref="base.user_root"/>

            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>

        </record>

    </data>
</odoo>
