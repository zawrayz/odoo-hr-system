<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="view_hr_biometric_bridge_status_list" model="ir.ui.view">
        <field name="name">hr.biometric.bridge.status.list</field>
        <field name="model">hr.biometric.bridge.status</field>
        <field name="arch" type="xml">
            <list
                string="Biometric Bridges"
                create="0"
                edit="0"
                delete="0"
                default_order="last_seen desc">

                <field name="is_online" widget="boolean_toggle"/>
                <field name="bridge_name"/>
                <field name="bridge_id"/>
                <field name="machine_name"/>
                <field name="device_code"/>
                <field name="last_seen"/>
                <field name="source_ip"/>
                <field name="app_version"/>
                <field name="last_message" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_hr_biometric_bridge_status_form" model="ir.ui.view">
        <field name="name">hr.biometric.bridge.status.form</field>
        <field name="model">hr.biometric.bridge.status</field>
        <field name="arch" type="xml">
            <form
                string="Biometric Bridge"
                create="0"
                edit="0"
                delete="0">

                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="bridge_name" readonly="1"/>
                        </h1>
                    </div>

                    <group>
                        <group string="Bridge">
                            <field name="is_online" readonly="1"/>
                            <field name="bridge_id" readonly="1"/>
                            <field name="machine_name" readonly="1"/>
                            <field name="app_version" readonly="1"/>
                        </group>

                        <group string="Connection">
                            <field name="device_code" readonly="1"/>
                            <field name="last_seen" readonly="1"/>
                            <field name="source_ip" readonly="1"/>
                            <field name="last_message" readonly="1"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_hr_biometric_bridge_status_search" model="ir.ui.view">
        <field name="name">hr.biometric.bridge.status.search</field>
        <field name="model">hr.biometric.bridge.status</field>
        <field name="arch" type="xml">
            <search string="Search Biometric Bridges">
                <field name="bridge_name"/>
                <field name="bridge_id"/>
                <field name="machine_name"/>
                <field name="device_code"/>
                <field name="source_ip"/>

                <filter
                    name="active"
                    string="Active"
                    domain="[('active', '=', True)]"/>

                <group>
                    <filter
                        name="group_device"
                        string="Device"
                        context="{'group_by': 'device_code'}"/>

                    <filter
                        name="group_machine"
                        string="Windows PC"
                        context="{'group_by': 'machine_name'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_hr_biometric_bridge_status" model="ir.actions.act_window">
        <field name="name">Biometric Bridges</field>
        <field name="res_model">hr.biometric.bridge.status</field>
        <field name="view_mode">list,form</field>
        <field
            name="search_view_id"
            ref="view_hr_biometric_bridge_status_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No biometric bridge has connected yet.
            </p>
            <p>
                Bridge computers will appear after sending
                their first heartbeat.
            </p>
        </field>
    </record>

    <menuitem
        id="menu_hr_biometric_bridge_status"
        name="Biometric Bridges"
        parent="hr.menu_hr_root"
        action="action_hr_biometric_bridge_status"
        sequence="93"
        groups="hr.group_hr_manager"/>

</odoo>
