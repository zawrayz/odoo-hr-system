<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <template
        id="hr_employee_sidebar_finance_link"
        inherit_id="hr_employee_portal.hr_employee_sidebar"
        name="HR Finance Sidebar Link"
    >
        <xpath
            expr="//a[@href='/my/hr/admin/documents']"
            position="after"
        >
            <t
                t-set="pc_sidebar_employee"
                t-value="request.env['hr.employee'].sudo().search([('user_id', '=', request.env.user.id)], limit=1)"
            />

            <t
                t-set="pc_sidebar_employee_code"
                t-value="(pc_sidebar_employee.employee_code or '').strip().upper() if pc_sidebar_employee else ''"
            />

            <t
                t-set="pc_sidebar_is_manager"
                t-value="request.env.user.has_group('hr.group_hr_manager')"
            />

            <t
                t-if="pc_sidebar_is_manager or pc_sidebar_employee_code in ['BPL001', 'BLMP43']"
            >
                <a
                    t-att-href="'/my/hr/admin/finance' if pc_sidebar_is_manager else '/my/hr/finance'"
                    t-attf-class="hr-sidebar-link #{'active' if current_page == 'admin_finance' else ''}"
                >
                    <i class="fa fa-money"/>
                    <span>Finance</span>
                </a>

                <div class="hr-sidebar-submenu">
                    <a
                        t-att-href="'/my/hr/admin/finance/petty-cash' if pc_sidebar_is_manager else '/my/hr/finance/petty-cash'"
                        t-attf-class="hr-sidebar-sublink #{'active' if current_page == 'admin_finance' else ''}"
                    >
                        <i class="fa fa-book"/>
                        <span>Petty Cash</span>
                    </a>
                </div>
            </t>
        </xpath>
        <xpath
            expr="//a[@href='/my/hr/documents']"
            position="after"
        >
            <t
                t-set="pc_employee_sidebar_record"
                t-value="request.env['hr.employee'].sudo().search([('user_id', '=', request.env.user.id)], limit=1)"
            />

            <t
                t-set="pc_employee_sidebar_code"
                t-value="(pc_employee_sidebar_record.employee_code or '').strip().upper() if pc_employee_sidebar_record else ''"
            />

            <t
                t-if="pc_employee_sidebar_code in ['BPL001', 'BLMP43']"
            >
                <a
                    href="/my/hr/finance"
                    t-attf-class="hr-sidebar-link #{'active' if current_page == 'admin_finance' else ''}"
                >
                    <i class="fa fa-money"/>
                    <span>Finance</span>
                </a>

                <div class="hr-sidebar-submenu">
                    <a
                        href="/my/hr/finance/petty-cash"
                        t-attf-class="hr-sidebar-sublink #{'active' if current_page == 'admin_finance' else ''}"
                    >
                        <i class="fa fa-book"/>
                        <span>Petty Cash</span>
                    </a>
                </div>
            </t>
        </xpath>
    </template>

    <template
        id="hr_admin_petty_cash_page"
        name="HR Admin Petty Cash Log"
    >
        <t t-call="portal.portal_layout">
            <t t-set="no_breadcrumbs" t-value="1"/>
            <t t-set="current_page" t-value="'admin_finance'"/>

            <div class="container-fluid oe_structure mt-4 mb-5 px-lg-4">
                <div class="hr-layout-row">

                    <div class="hr-sidebar-wrap">
                        <t t-call="hr_employee_portal.hr_employee_sidebar"/>
                    </div>

                    <div class="hr-content-wrap">

                        <div class="mb-3">
                            <a
                                t-att-href="'/my/hr/admin' if is_hr_manager else '/my/hr'"
                                class="hr-back-link"
                            >
                                <i class="fa fa-arrow-left"/>

                                <t t-if="is_hr_manager">
                                    Back to Admin Dashboard
                                </t>

                                <t t-else="">
                                    Back to Employee Dashboard
                                </t>
                            </a>
                        </div>

                        <div class="pc-log-card">

                            <div class="pc-title-row">
                                <div class="pc-brand">BLIMP</div>
                                <div class="pc-title">Petty Cash Log</div>
                            </div>

                            <div class="pc-toolbar">

                                <div class="pc-balance-card">
                                    <div class="pc-balance-label">
                                        Current Balance
                                    </div>

                                    <div class="pc-balance-value">
                                        Rs
                                        <t t-esc="'{:,.2f}'.format(balance)"/>
                                    </div>
                                </div>

                                <div class="pc-balance-card pc-month-expense-card">
                                    <div class="pc-balance-label">
                                        <t t-esc="selected_month_label"/>
                                        Expense
                                    </div>

                                    <div class="pc-balance-value">
                                        Rs
                                        <t t-esc="'{:,.2f}'.format(monthly_expense)"/>
                                    </div>
                                </div>

                                <form
                                    t-att-action="finance_page_url"
                                    method="get"
                                    class="pc-filter-form"
                                >
                                    <div class="pc-filter-field">
                                        <label for="pc_fiscal_year">
                                            Fiscal Year
                                        </label>

                                        <select
                                            id="pc_fiscal_year"
                                            name="fy"
                                            onchange="this.form.submit()"
                                        >
                                            <option
                                                t-foreach="fiscal_year_options"
                                                t-as="fy_option"
                                                t-att-value="fy_option['value']"
                                                t-att-selected="selected_fiscal_year == fy_option['value'] and 'selected' or None"
                                            >
                                                <t t-esc="fy_option['label']"/>
                                            </option>
                                        </select>
                                    </div>

                                    <div class="pc-filter-field">
                                        <label for="pc_month">
                                            Month
                                        </label>

                                        <select
                                            id="pc_month"
                                            name="month"
                                            onchange="this.form.submit()"
                                        >
                                            <option
                                                t-foreach="month_options"
                                                t-as="month_option"
                                                t-att-value="month_option['value']"
                                                t-att-selected="selected_month == month_option['value'] and 'selected' or None"
                                            >
                                                <t t-esc="month_option['label']"/>
                                            </option>
                                        </select>
                                    </div>
                                </form>

                                <button
                                    type="button"
                                    class="pc-add-entry-button"
                                    data-bs-toggle="modal"
                                    data-bs-target="#pettyCashEntryModal"
                                >
                                    <i class="fa fa-plus-circle"/>
                                    Add Entry
                                </button>

                            </div>

                            <t t-if="entry_added">
                                <div class="pc-entry-message pc-entry-success">
                                    <i class="fa fa-check-circle"/>
                                    Petty cash entry added successfully.
                                </div>
                            </t>

                            <t t-if="entry_updated">
                                <div class="pc-entry-message pc-entry-success">
                                    <i class="fa fa-check-circle"/>
                                    Petty cash entry updated successfully.
                                </div>
                            </t>

                            <t t-if="entry_error">
                                <div class="pc-entry-message pc-entry-error">
                                    <i class="fa fa-exclamation-circle"/>
                                    <t t-esc="entry_error"/>
                                </div>
                            </t>

                            <div class="pc-table-wrap">
                                <table t-attf-class="pc-table #{'pc-table-no-actions' if not can_edit_entries else ''}">

                                    <thead>
                                        <tr>
                                            <th>Month</th>
                                            <th>Date</th>
                                            <th>Description</th>
                                            <th>Amount</th>
                                            <th>Transaction Type</th>
                                            <th>Remarks</th>
                                            <th>Invoice Sharing Status</th>
                                            <th t-if="can_edit_entries">Action</th>
                                        </tr>
                                    </thead>

                                    <tbody>

                                        <t t-if="entries">
                                            <tr
                                                t-foreach="entries"
                                                t-as="entry"
                                            >
                                                <td class="pc-month-cell">
                                                    <t t-esc="entry.month_label or '-'"/>
                                                </td>

                                                <td class="pc-date-cell">
                                                    <t
                                                        t-esc="entry.transaction_date.strftime('%d-%b-%Y').lstrip('0') if entry.transaction_date else '-'"
                                                    />
                                                </td>

                                                <td class="pc-description-cell">
                                                    <t t-esc="entry.description or '-'"/>
                                                </td>

                                                <td class="pc-money-cell">
                                                    <t t-if="entry.net_amount">
                                                        Rs
                                                        <t t-esc="'{:,.2f}'.format(abs(entry.net_amount))"/>
                                                    </t>
                                                    <t t-else="">-</t>
                                                </td>

                                                <td class="pc-type-cell">
                                                    <span
                                                        t-if="entry.net_amount >= 0"
                                                        class="pc-type-badge pc-type-in"
                                                    >
                                                        <i class="fa fa-arrow-down"/>
                                                        Cash In
                                                    </span>

                                                    <span
                                                        t-else=""
                                                        class="pc-type-badge pc-type-out"
                                                    >
                                                        <i class="fa fa-arrow-up"/>
                                                        Cash Out
                                                    </span>
                                                </td>

                                                <td class="pc-description-cell">
                                                    <t t-esc="entry.remarks or '-'"/>
                                                </td>

                                                <td
                                                    t-attf-class="pc-status-cell #{'is-shared' if entry.invoice_shared else 'not-shared'}"
                                                >
                                                    <t t-if="entry.invoice_shared">
                                                        Yes
                                                    </t>
                                                    <t t-else="">No</t>
                                                </td>

                                                <td t-if="can_edit_entries" class="pc-action-cell">
                                                    <t t-if="not entry.invoice_shared">
                                                        <button
                                                            type="button"
                                                            class="pc-edit-button"
                                                            data-bs-toggle="modal"
                                                            t-att-data-bs-target="'#pettyCashEditModal%s' % entry.id"
                                                        >
                                                            <i class="fa fa-pencil"/>
                                                            Edit
                                                        </button>
                                                    </t>

                                                    <t t-else="">
                                                        <span
                                                            class="pc-locked-badge"
                                                            title="Editing is disabled because the invoice has been shared."
                                                        >
                                                            <i class="fa fa-lock"/>
                                                            Locked
                                                        </span>
                                                    </t>
                                                </td>
                                            </tr>
                                        </t>

                                        <t t-else="">
                                            <tr>
                                                <td
                                                    t-att-colspan="8 if can_edit_entries else 7"
                                                    class="pc-empty-cell"
                                                >
                                                    No petty cash entries exist for
                                                    <t t-esc="selected_fiscal_year_label"/>

                                                    <t t-if="selected_month">
                                                        and the selected month
                                                    </t>.
                                                </td>
                                            </tr>
                                        </t>

                                    </tbody>

                                </table>
                            </div>

                            <div
                                t-if="entry_count"
                                class="pc-pagination-bar"
                            >
                                <div class="pc-pagination-summary">
                                    Showing
                                    <strong>
                                        <t t-esc="page_first_entry"/>
                                    </strong>
                                    –
                                    <strong>
                                        <t t-esc="page_last_entry"/>
                                    </strong>
                                    of
                                    <strong>
                                        <t t-esc="entry_count"/>
                                    </strong>
                                    entries
                                </div>

                                <div
                                    t-if="pager.get('page_count', 1) > 1"
                                    class="pc-pagination-controls"
                                >
                                    <t t-call="portal.pager"/>
                                </div>
                            </div>

                        </div>

                    </div>
                </div>
            </div>

            <div
                class="modal fade"
                id="pettyCashEntryModal"
                tabindex="-1"
                aria-labelledby="pettyCashEntryModalLabel"
                aria-hidden="true"
            >
                <div class="modal-dialog modal-lg modal-dialog-centered">
                    <div class="modal-content pc-modal-content">

                        <form
                            t-att-action="'%s/petty-cash/add' % finance_page_url"
                            method="post"
                        >
                            <input
                                type="hidden"
                                name="csrf_token"
                                t-att-value="request.csrf_token()"
                            />

                            <input
                                type="hidden"
                                name="selected_fiscal_year"
                                t-att-value="selected_fiscal_year"
                            />

                            <input
                                type="hidden"
                                name="selected_month"
                                t-att-value="selected_month"
                            />

                            <div class="modal-header pc-modal-header">
                                <div>
                                    <h5
                                        class="modal-title"
                                        id="pettyCashEntryModalLabel"
                                    >
                                        Add Petty Cash Entry
                                    </h5>

                                    <div class="pc-modal-subtitle">
                                        Enter an opening balance as Cash In.
                                    </div>
                                </div>

                                <button
                                    type="button"
                                    class="btn-close btn-close-white"
                                    data-bs-dismiss="modal"
                                    aria-label="Close"
                                ></button>
                            </div>

                            <div class="modal-body pc-modal-body">

                                <div class="pc-entry-grid">

                                    <div class="pc-entry-field">
                                        <label for="pc_transaction_date">
                                            Date
                                        </label>

                                        <input
                                            id="pc_transaction_date"
                                            type="date"
                                            name="transaction_date"
                                            t-att-value="today_value"
                                            required="required"
                                        />
                                    </div>

                                    <div class="pc-entry-field">
                                        <label for="pc_invoice_shared">
                                            Invoice Sharing Status
                                        </label>

                                        <select
                                            id="pc_invoice_shared"
                                            name="invoice_shared"
                                        >
                                            <option value="0">No</option>
                                            <option value="1">Yes</option>
                                        </select>
                                    </div>

                                    <div class="pc-entry-field pc-full-width">
                                        <label for="pc_description">
                                            Description
                                        </label>

                                        <input
                                            id="pc_description"
                                            type="text"
                                            name="description"
                                            placeholder="Example: Opening Balance"
                                            required="required"
                                        />
                                    </div>

                                    <div class="pc-entry-field">
                                        <label for="pc_amount">
                                            Amount
                                        </label>

                                        <input
                                            id="pc_amount"
                                            type="number"
                                            name="amount"
                                            min="0.01"
                                            step="0.01"
                                            placeholder="0.00"
                                            required="required"
                                        />
                                    </div>

                                    <div class="pc-entry-field">
                                        <label for="pc_transaction_type">
                                            Transaction Type
                                        </label>

                                        <select
                                            id="pc_transaction_type"
                                            name="transaction_type"
                                            required="required"
                                        >
                                            <option value="check_in">
                                                Cash In
                                            </option>
                                            <option value="check_out">
                                                Cash Out
                                            </option>
                                        </select>
                                    </div>

                                    <div class="pc-entry-field pc-full-width">
                                        <label for="pc_remarks">
                                            Remarks
                                        </label>

                                        <textarea
                                            id="pc_remarks"
                                            name="remarks"
                                            rows="3"
                                            placeholder="Optional remarks"
                                        ></textarea>
                                    </div>

                                </div>

                            </div>

                            <div class="modal-footer pc-modal-footer">
                                <button
                                    type="button"
                                    class="btn btn-light"
                                    data-bs-dismiss="modal"
                                >
                                    Cancel
                                </button>

                                <button
                                    type="submit"
                                    class="pc-modal-submit"
                                >
                                    <i class="fa fa-plus-circle"/>
                                    Add Entry
                                </button>
                            </div>

                        </form>

                    </div>
                </div>
            </div>

            <t
                t-if="can_edit_entries"
                t-foreach="entries.filtered(lambda item: not item.invoice_shared)"
                t-as="edit_entry"
            >
                <div
                    class="modal fade"
                    t-att-id="'pettyCashEditModal%s' % edit_entry.id"
                    tabindex="-1"
                    t-att-aria-labelledby="'pettyCashEditModalLabel%s' % edit_entry.id"
                    aria-hidden="true"
                >
                    <div class="modal-dialog modal-lg modal-dialog-centered">
                        <div class="modal-content pc-modal-content">

                            <form
                                t-att-action="'%s/petty-cash/%s/edit' % (finance_page_url, edit_entry.id)"
                                method="post"
                            >
                                <input
                                    type="hidden"
                                    name="csrf_token"
                                    t-att-value="request.csrf_token()"
                                />

                                <input
                                    type="hidden"
                                    name="selected_fiscal_year"
                                    t-att-value="selected_fiscal_year"
                                />

                                <input
                                    type="hidden"
                                    name="selected_month"
                                    t-att-value="selected_month"
                                />

                                <div class="modal-header pc-modal-header">
                                    <div>
                                        <h5
                                            class="modal-title"
                                            t-att-id="'pettyCashEditModalLabel%s' % edit_entry.id"
                                        >
                                            Edit Petty Cash Entry
                                        </h5>

                                        <div class="pc-modal-subtitle">
                                            Changing Invoice Sharing Status to Yes will permanently lock this entry.
                                        </div>
                                    </div>

                                    <button
                                        type="button"
                                        class="btn-close btn-close-white"
                                        data-bs-dismiss="modal"
                                        aria-label="Close"
                                    ></button>
                                </div>

                                <div class="modal-body pc-modal-body">
                                    <div class="pc-entry-grid">

                                        <div class="pc-entry-field">
                                            <label
                                                t-att-for="'pc_edit_date_%s' % edit_entry.id"
                                            >
                                                Date
                                            </label>

                                            <input
                                                t-att-id="'pc_edit_date_%s' % edit_entry.id"
                                                type="date"
                                                name="transaction_date"
                                                t-att-value="edit_entry.transaction_date.strftime('%Y-%m-%d') if edit_entry.transaction_date else ''"
                                                required="required"
                                            />
                                        </div>

                                        <div class="pc-entry-field">
                                            <label
                                                t-att-for="'pc_edit_invoice_%s' % edit_entry.id"
                                            >
                                                Invoice Sharing Status
                                            </label>

                                            <select
                                                t-att-id="'pc_edit_invoice_%s' % edit_entry.id"
                                                name="invoice_shared"
                                            >
                                                <option value="0" selected="selected">
                                                    No
                                                </option>
                                                <option value="1">
                                                    Yes — Lock Entry
                                                </option>
                                            </select>
                                        </div>

                                        <div class="pc-entry-field pc-full-width">
                                            <label
                                                t-att-for="'pc_edit_description_%s' % edit_entry.id"
                                            >
                                                Description
                                            </label>

                                            <input
                                                t-att-id="'pc_edit_description_%s' % edit_entry.id"
                                                type="text"
                                                name="description"
                                                t-att-value="edit_entry.description or ''"
                                                required="required"
                                            />
                                        </div>

                                        <div class="pc-entry-field">
                                            <label
                                                t-att-for="'pc_edit_amount_%s' % edit_entry.id"
                                            >
                                                Amount
                                            </label>

                                            <input
                                                t-att-id="'pc_edit_amount_%s' % edit_entry.id"
                                                type="number"
                                                name="amount"
                                                min="0.01"
                                                step="0.01"
                                                t-att-value="'%.2f' % abs(edit_entry.net_amount)"
                                                required="required"
                                            />
                                        </div>

                                        <div class="pc-entry-field">
                                            <label
                                                t-att-for="'pc_edit_type_%s' % edit_entry.id"
                                            >
                                                Transaction Type
                                            </label>

                                            <select
                                                t-att-id="'pc_edit_type_%s' % edit_entry.id"
                                                name="transaction_type"
                                                required="required"
                                            >
                                                <option
                                                    value="check_in"
                                                    t-att-selected="edit_entry.net_amount >= 0 and 'selected' or None"
                                                >
                                                    Cash In
                                                </option>

                                                <option
                                                    value="check_out"
                                                    t-att-selected="edit_entry.net_amount &lt; 0 and 'selected' or None"
                                                >
                                                    Cash Out
                                                </option>
                                            </select>
                                        </div>

                                        <div class="pc-entry-field pc-full-width">
                                            <label
                                                t-att-for="'pc_edit_remarks_%s' % edit_entry.id"
                                            >
                                                Remarks
                                            </label>

                                            <textarea
                                                t-att-id="'pc_edit_remarks_%s' % edit_entry.id"
                                                name="remarks"
                                                rows="3"
                                            ><t t-esc="edit_entry.remarks or ''"/></textarea>
                                        </div>

                                    </div>
                                </div>

                                <div class="modal-footer pc-modal-footer">
                                    <button
                                        type="button"
                                        class="btn btn-light"
                                        data-bs-dismiss="modal"
                                    >
                                        Cancel
                                    </button>

                                    <button
                                        type="submit"
                                        class="pc-modal-submit"
                                    >
                                        <i class="fa fa-save"/>
                                        Save Changes
                                    </button>
                                </div>

                            </form>

                        </div>
                    </div>
                </div>
            </t>

        </t>
    </template>

</odoo>