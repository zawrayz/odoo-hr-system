<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_hr_daily_performance_plan_list" model="ir.ui.view">
        <field name="name">hr.daily.performance.plan.list</field>
        <field name="model">hr.daily.performance.plan</field>
        <field name="arch" type="xml">
            <list string="Daily Performance &amp; Project Plan">
                <field name="plan_date"/>
                <field name="employee_id"/>
                <field name="task_id"/>
                <field name="project_name"/>
                <field name="task_description"/>
                <field name="priority_level"/>
                <field name="status"/>
                <field name="completion_percent"/>
                <field name="supervisor_remarks"/>
            </list>
        </field>
    </record>

    <record id="view_hr_daily_performance_plan_form" model="ir.ui.view">
        <field name="name">hr.daily.performance.plan.form</field>
        <field name="model">hr.daily.performance.plan</field>
        <field name="arch" type="xml">
            <form string="Daily Performance &amp; Project Plan">
                <sheet>
                    <group>
                        <group>
                            <field name="employee_id"/>
                            <field name="plan_date"/>
                            <field name="task_id"/>
                            <field name="project_name"/>
                        </group>
                        <group>
                            <field name="priority_level"/>
                            <field name="status"/>
                            <field name="completion_percent"/>
                        </group>
                    </group>
                    <group>
                        <field name="task_description"/>
                        <field name="supervisor_remarks"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_hr_daily_performance_plan" model="ir.actions.act_window">
        <field name="name">Daily Performance &amp; Project Plan</field>
        <field name="res_model">hr.daily.performance.plan</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>